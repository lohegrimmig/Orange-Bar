# Orange-Bar Konfiguration (alle Werte optional; Standardwerte siehe server/config.js)

# Port des Servers
PORT=8787

# WebAuthn Relying-Party: die Domain, unter der die App läuft (ohne https://)
ORANGE_RP_ID=localhost
ORANGE_RP_NAME=Orange-Bar

# Erwartete Browser-Origins (kommagetrennt). In Produktion: https://deine-domain
ORANGE_ORIGINS=http://localhost:8787

# Externe Apps, die Login/Payout per Redirect nutzen dürfen (kommagetrennt).
# Beispiel Mintly Lab: https://mintlylab.com
# ORANGE_TRUSTED_APPS=https://mintlylab.com,http://localhost:5173

# Gemeinsames Secret mit Mintly für Non-Custodial-Wallet-Login (HMAC-Attestation).
# Ohne dieses Secret (Fallback: ORANGE_MASTER_KEY) schlägt Mintly-Login im Non-Custodial-Modus fehl.
# ORANGE_MINTLY_LOGIN_SECRET=

# Standard-Netzwerk für neue Nutzer: testnet | devnet | mainnet
# (In der App kann jeder Nutzer jederzeit umschalten.)
ORANGE_IOTA_NETWORK=testnet

# Optionale eigene RPC-Endpunkte je Netzwerk
# ORANGE_IOTA_RPC_TESTNET=https://api.testnet.iota.cafe
# ORANGE_IOTA_RPC_DEVNET=
# ORANGE_IOTA_RPC_MAINNET=

# Zusätzliche Admin-Nutzernamen (kommagetrennt). Der erste registrierte
# Nutzer wird ohnehin automatisch Admin.
# ORANGE_ADMIN_USERS=lohe

# Master-Key zur Verschlüsselung der Wallet- und 2FA-Schlüssel (32 Byte hex = 64 Zeichen).
# PFLICHT in Produktion! Erzeugen mit: openssl rand -hex 32
# ORANGE_MASTER_KEY=

# Wallet-Modus (seit v1.0.0):
# Standard = Non-Custodial (kein Server-Zugriff auf Nutzer-Schlüssel, PRF erforderlich).
# ORANGE_CUSTODIAL_MODE=1 aktiviert den Legacy-Custodial-Modus – MiCA-Warnung, siehe docs/CUSTODIAL.md
# ORANGE_CUSTODIAL_MODE=1

# Pfad zur SQLite-Datenbank
# ORANGE_DB_PATH=./data/orange-bar.db

# ── Rechtstexte (Impressum, Datenschutz, AGB) ─────────────────────────────
# Pflicht für öffentlichen Produktionsbetrieb. Ausführliche Erklärung: docs/LEGAL.md
#
# ORANGE_LEGAL_NAME=Musterfirma GmbH          # Betreiber (Firma oder voller Name)
# ORANGE_LEGAL_FORM=GmbH                       # optional: Rechtsform
# ORANGE_LEGAL_STREET=Musterstraße 1
# ORANGE_LEGAL_ZIP=12345
# ORANGE_LEGAL_CITY=Musterstadt
# ORANGE_LEGAL_COUNTRY=Deutschland             # optional, Standard: Deutschland
# ORANGE_LEGAL_EMAIL=support@musterfirma.de    # Pflicht für konfigurierte Texte
# ORANGE_LEGAL_PHONE=+49 123 456789            # optional, in DE oft empfohlen
# ORANGE_LEGAL_WEBSITE=https://musterfirma.de  # optional
# ORANGE_LEGAL_REGISTER=HRB 12345              # optional
# ORANGE_LEGAL_REGISTER_COURT=Amtsgericht …    # optional
# ORANGE_LEGAL_VAT_ID=DE123456789              # optional
# ORANGE_LEGAL_RESPONSIBLE=Max Mustermann      # optional, § 18 MStV; Standard: NAME
# ORANGE_LEGAL_DPO_EMAIL=datenschutz@…         # optional, falls DSB bestellt
# ORANGE_LEGAL_SERVICE_NAME=Meine Wallet       # optional; Standard: ORANGE_RP_NAME
# ORANGE_LEGAL_CUSTODY_NOTE=…                  # optional, nur Custodial-Impressum

# Web-Push (Benachrichtigungen bei Zahlungseingang).
# Ohne Angabe werden VAPID-Schlüssel beim ersten Start erzeugt (data/vapid.json).
# Erzeugen z. B. mit: npx web-push generate-vapid-keys
# ORANGE_VAPID_PUBLIC=
# ORANGE_VAPID_PRIVATE=
# ORANGE_VAPID_SUBJECT=mailto:admin@deine-domain
# Poll-Intervall des Guthaben-Beobachters in ms (Standard 30000); '1' schaltet ihn ab:
# ORANGE_WATCH_INTERVAL_MS=30000
# ORANGE_DISABLE_WATCHER=0

# ── Facilitator-Demo (x402-artig, verify-only) ────────────────────────────
# Nur mit gesetzter Adresse aktiv: GET /api/facilitator/demo/resource zeigt den
# vollen 402 → zahlen → freischalten-Flow. Siehe docs/FACILITATOR.md.
# ORANGE_FACILITATOR_DEMO_PAYTO=0x…
# ORANGE_FACILITATOR_DEMO_AMOUNT_NANOS=10000000
